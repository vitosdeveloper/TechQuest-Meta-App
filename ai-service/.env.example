# Obtenha sua chave em: https://platform.openai.com/api-keys

# Para usar a OpenAI:
OPENAI_API_KEY=sk-fallback-key-para-nao-travar-o-servidor

# Para usar Modelos Locais com Ollama (100% Grátis e Offline):
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
PORT=3004
